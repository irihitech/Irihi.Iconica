<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>library</OutputType>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Version>1.0.0</Version>
        <PackageId>Irihi.Iconica.TDesign</PackageId>
        <PackageIcon>irihi.png</PackageIcon>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <Authors>IRIHI Technology Co., Ltd. 上海铱泓科技服务有限公司</Authors>
        <RootNamespace>Irihi.Iconica</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Irihi.Iconica.Core\Irihi.Iconica.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="../../irihi.png" Pack="true" PackagePath="" Visible="false"/>
        <None Include="../../LICENSE" Pack="true" PackagePath="" Visible="false"/>
        <None Include="NOTICE" Pack="true" PackagePath="" Visible="false"/>
        <None Include="README.md" Pack="true" PackagePath="" Visible="false"/>
    </ItemGroup>
</Project>
